# Reescritura opcional: permite /api/tickets ademas de /api/index.php?_ruta=tickets
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?_ruta=$1 [QSA,L]
</IfModule>

# La cabecera Authorization no siempre llega a PHP en CGI/FastCGI
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# El fichero de configuracion nunca se sirve
<FilesMatch "^(config\.local\.php|.*\.sqlite.*)$">
  Require all denied
</FilesMatch>
